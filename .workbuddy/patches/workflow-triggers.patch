diff --git a/.github/workflows/rust-tests.yml b/.github/workflows/rust-tests.yml
index 40b511a2..9354b08f 100644
--- a/.github/workflows/rust-tests.yml
+++ b/.github/workflows/rust-tests.yml
@@ -1,15 +1,22 @@
 name: rust-tests
 
+# ── 触发面为什么带 main-patched ──────────────────────────────────
+# 本 fork 的默认分支是 `main-patched`，日常开发与交付都发生在它上面。
+# 上游写的 `[main, beta]` 是主仓的分支名 —— 在这个 fork 里这两个分支不存在，
+# 于是这条流水线**从来不会因为 push 自动跑**，历史上每一个 run 都是手动
+# `workflow_dispatch`。那等于把「要不要跑测试」变成靠人记得的事，
+# 而实际结果是既漏跑、又漏出包。
+# 这里把 `main-patched` 补进来：推代码 = 自动跑测试，不再依赖记性。
 on:
   push:
-    branches: [main, beta]
+    branches: [main, beta, main-patched]
     paths:
       - 'desktop-tauri/src-tauri/**'
       - 'scripts/cargo-test.mjs'
       - '.github/workflows/rust-tests.yml'
       - 'package.json'
   pull_request:
-    branches: [main, beta]
+    branches: [main, beta, main-patched]
     paths:
       - 'desktop-tauri/src-tauri/**'
       - 'scripts/cargo-test.mjs'
