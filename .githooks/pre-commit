#!/bin/sh
#
# pre-commit：本次提交若动了前端源码，就自动重建入库产物并一起提交。
#
# ── 为什么需要它 ──────────────────────────────────────────────
# 本仓库把前端构建产物**入库**（ui/islands/ui.js、ui/islands/ui.css、
# ui/i18n/**、ui/m/**、ui/sw.js），Tauri 打包（tauri.conf.json 的
# frontendDist 指向 ui/）与 Docker 镜像（Dockerfile COPY ui/）都直接取
# 这些字节 —— 仓库里那几份就是用户拿到的界面，没有任何构建兜底。
#
# 于是「改了源码忘了重建」会一路进分支，而 review 看不出 1 MB 压缩产物
# 里少了什么。CI 的 frontend-artifacts 闸能在推送后拦住，但那时代码已经
# 进了远端；这道钩子把拦截提前到本地提交前 —— 忘了也交不上去。
#
# ── 行为 ──────────────────────────────────────────────────────
# 检测暂存区里是否含前端源码改动，有则重建对应产物并 git add：
#   ui-islands / ui-kit → desktop-tauri/ui/islands/{ui.js,ui.css}
#   mobile              → desktop-tauri/ui/m/** 与 desktop-tauri/ui/sw.js
#   i18n                → desktop-tauri/ui/i18n/**
# 任何一步构建失败都会中止提交（产物没更新，提交出去就与源码不同源）。
#
# ── 逃生门 ────────────────────────────────────────────────────
# 刻意想分开提交（例如先提源码再提产物）时：
#   git commit --no-verify
# 关掉钩子（本机生效）：
#   git config --unset core.hooksPath

set -e

# 暂存区名单落到临时文件：管道里的 while 跑在子 shell 里，变量传不出来
staged="$(mktemp)"
trap 'rm -f "$staged"' EXIT
git diff --cached --name-only --diff-filter=ACMR > "$staged"

# ── Rust 静态预检（不需要 cargo）──────────────────────────────
# 本机通常没有 Rust 工具链，「改了结构体定义忘了同步字面量」这类错误只能
# 推上去等 CI 红灯。2026-11-20 连着踩了两次（make_id 参数、MemoryConfig 字段），
# 每次都烧一轮 CI。这道检查在提交前把它挡下来。
#
# 只有动了 Rust 源码时才跑；脚本本身不做编译，纯文本解析，几十毫秒。
if grep -q '^desktop-tauri/src-tauri/.*\.rs$' "$staged"; then
  if command -v node > /dev/null 2>&1; then
    echo "pre-commit: 检测到 Rust 源码改动，跑静态预检……"
    if ! node scripts/precheck-rust.mjs; then
      echo "" >&2
      echo "pre-commit: Rust 静态预检不通过，已中止提交。" >&2
      echo "  修好上面的字段不一致再提交；确有特殊情况可 git commit --no-verify 跳过。" >&2
      exit 1
    fi
    if ! node scripts/precheck-knobs.mjs; then
      echo "" >&2
      echo "pre-commit: 旋钮 schema 预检不通过，已中止提交。" >&2
      exit 1
    fi
  else
    echo "pre-commit: 找不到 node，跳过 Rust 静态预检（CI 仍会拦）。" >&2
  fi
fi

# ── 工作流 YAML 预检（不需要 actionlint）────────────────────────
# 改了 .github/workflows/** 就得保证 YAML 还能被 GitHub 解析。
# 本机没有 actionlint，GitHub 解析失败的表现是「整条工作流静默不跑」——
# 连报错都没有：闸门不生效、出包不发生，而且看不出原因。
# 这道检查把最常见的几类写坏提前到提交前。
if grep -q '^\.github/workflows/.*\.ya\?ml$' "$staged"; then
  if command -v node > /dev/null 2>&1; then
    echo "pre-commit: 检测到工作流改动，跑 YAML 预检……"
    if ! node scripts/precheck-workflows.mjs; then
      echo "" >&2
      echo "pre-commit: 工作流 YAML 预检不通过，已中止提交。" >&2
      exit 1
    fi
  else
    echo "pre-commit: 找不到 node，跳过工作流 YAML 预检（CI 仍会拦）。" >&2
  fi
fi

need_islands=0
need_mobile=0
need_i18n=0

while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    # ui-kit 以源码方式被两端引用：岛走 vite alias，手机端引它的样式
    desktop-tauri/ui-kit/* | desktop-tauri/ui-islands/*)
      need_islands=1
      need_mobile=1
      ;;
    desktop-tauri/i18n/*)
      need_i18n=1
      ;;
    # 手机端原生工程不参与 Web 产物，改了不用重建
    desktop-tauri/mobile/android/* | desktop-tauri/mobile/ios/* | desktop-tauri/mobile/android-www/*)
      ;;
    desktop-tauri/mobile/*)
      need_mobile=1
      ;;
  esac
done < "$staged"

if [ "$need_islands" = 0 ] && [ "$need_mobile" = 0 ] && [ "$need_i18n" = 0 ]; then
  exit 0
fi

if ! command -v npm > /dev/null 2>&1 && ! command -v npm.cmd > /dev/null 2>&1; then
  echo "pre-commit: 检测到前端源码改动，但找不到 npm，无法重建产物。" >&2
  echo "  装好 Node 后重试，或用 git commit --no-verify 跳过（不推荐）。" >&2
  exit 1
fi

# ── 绕开 npm 的 bash shim ────────────────────────────────────
# Windows 上 `npm` 是带 `#!/usr/bin/env bash` 的 shim。PATH 里一旦
# `C:\Windows\system32\bash.exe`（WSL 转发器）排在 Git Bash 前面 —— 本机
# 正是这个顺序 —— 它就去**启动 WSL**：输出「适用于 Linux 的 Windows 子系统
# 没有已安装的分发」，构建一行都没跑，而钩子按失败中止提交。2026-11-20 真
# 踩过，同一台机器上时好时坏，全看 PATH 顺序。
#
# 所以直接调 npm 的 CLI 入口，不经过任何 shim。注意要给 node 一个 **Windows
# 路径**：node.exe 会把 `/c/Users/...` 当成「当前盘符下的 \c\Users\...」。
NPM_CLI="$(dirname "$(command -v node)")/node_modules/npm/bin/npm-cli.js"
run_npm() {
  if [ -f "$NPM_CLI" ]; then
    node "$(cygpath -w "$NPM_CLI" 2>/dev/null || echo "$NPM_CLI")" "$@"
  else
    npm "$@"
  fi
}

echo "pre-commit: 检测到前端源码改动，重建入库产物……"

if [ "$need_islands" = 1 ]; then
  run_npm --prefix desktop-tauri/ui-islands run build
fi
if [ "$need_mobile" = 1 ]; then
  run_npm --prefix desktop-tauri/mobile run build
fi
if [ "$need_i18n" = 1 ]; then
  run_npm --prefix desktop-tauri/i18n run build
fi

# 只 add 产物所在目录：ui/ 根下的 app.js、css/ 等是手写文件，不归钩子管
[ "$need_islands" = 1 ] && git add desktop-tauri/ui/islands
[ "$need_mobile" = 1 ] && git add desktop-tauri/ui/m desktop-tauri/ui/sw.js
[ "$need_i18n" = 1 ] && git add desktop-tauri/ui/i18n

# 产物更新后可能在暂存区留下差异（也可能没有 —— 那说明本来就同源），
# 两种情况都放行；真正的把关交给构建是否成功
echo "pre-commit: 产物已重建并加入本次提交"
exit 0
